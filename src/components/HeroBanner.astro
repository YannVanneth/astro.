---
import { DATA } from '../data/data';
import { Image } from 'astro:assets';
import { Button } from '@/components/ui/button.tsx';
import BANNER from '../../public/images/mid_year_banner.jpg';
---

<section id="hero" class="w-[72.5%] mx-auto overflow-hidden">
    <Image src={BANNER} alt="Zendo" />

    <div class="flex justify-center">
        <div class="absolute">
            <div class="relative bottom-30 flex gap-4">
                <Button className="border-2 px-6 py-5 rounded-sm bg-transparent font-['Helvetica'] text-base hover:bg-transparent hover:-translate-y-2 hover:transition-all hover:duration-300 cursor-pointer">
                    SHOP MEN
                </Button>
                <Button className="border-2 px-6 py-5 rounded-sm bg-transparent font-['Helvetica'] text-base hover:bg-transparent hover:-translate-y-2 hover:transition-all hover:duration-300 cursor-pointer">
                    SHOP WOMEN
                </Button>
            </div>
        </div>
    </div>

    <section class="flex justify-between">
        {DATA.collaboration.map(item => (
                <Image src={item.url} alt={item.label} width="170" height="170" />
        ))}
    </section>
</section>
