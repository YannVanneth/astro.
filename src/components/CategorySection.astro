---
import { DATA } from '@/data/data.ts';
import { Image } from 'astro:assets';
---

<section id="category-section" class="grid grid-cols-3 gap-10 w-[72.5%] mx-auto overflow-hidden">
  {DATA.category_section.map((item) => {
    return <Image src={item.url} alt={item.label} width={450} height={150} class="object-contain rounded-sm"/>;
  })}
</section>

